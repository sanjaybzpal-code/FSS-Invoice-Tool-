{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{Invoices/**,Exports/**,temp_imports/**,logs/**,app.py,*.bat,*.ps1,*.pyw,**/__pycache__/**,**/*.pdf,**/*.xlsx,auth.json,.secret_key}"
    },
    "web.py": {
      "maxDuration": 60,
      "excludeFiles": "{Invoices/**,Exports/**,temp_imports/**,logs/**,app.py,*.bat,*.ps1,*.pyw,**/__pycache__/**,**/*.pdf,**/*.xlsx,auth.json,.secret_key}"
    }
  }
}
